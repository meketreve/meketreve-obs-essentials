# Exclude everything
/*

# Except for default project files
!/.github
!/build-aux
!/cmake
!/data
!/src
!/tests
!/site
!/server
!.clang-format
!.gersemirc
!.gitignore
!buildspec.json
!CMakeLists.txt
!CMakePresets.json
!LICENSE
!README.md

# Only the cloud session hook from .claude (the rest stays local)
!/.claude
/.claude/*
!/.claude/settings.json
!/.claude/hooks

# Exclude lock files
*.lock.json

# Exclude macOS legacy resource forks
.DS_Store

# Exclude CMake build number cache
/cmake/.CMakeBuildNumber

# Generated site
/site/_site

# Python bytecode
__pycache__/
